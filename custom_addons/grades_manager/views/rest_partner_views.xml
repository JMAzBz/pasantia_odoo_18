<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia de la vista de contactos (res.partner) para agregar el campo is_teacher --> 
    <record id="view_partner_form_inherit_teacher" model="ir.ui.view">
        <field name="name">res.partner.form.teacher.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="is_teacher"/>
            </field>
            <field name="category_id" position="after">
                <field name="is_student"/>
            </field>
    <!-- encuentra todo el group y busca el padre del elemnto vat --> 
            <xpath expr="//field[@name='vat']/.." position="inside">    
                <field name="is_freelance"/>
            </xpath>
        </field>
    </record>       

    <!-- 1. Definición de la vista de lista personalizada para profesores -->
    <record id="teacher_list_view" model="ir.ui.view">
        <field name="name">teacher.list.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml"> 
            <list string="Teachers">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/> 
                <field name="is_teacher"/> 
                <field name="is_freelance"/> 
            </list>
        </field>
    </record>

    <!-- 2. Definición de la vista de formulario personalizada para profesores -->
    <record id="teacher_form_view" model="ir.ui.view">
        <field name="name">teacher.form.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/> 
                        <field name="is_teacher"/> 
                        <field name="is_freelance"/> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Definición de la acción -->
    <record id="teachers_action" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_teacher', '=', True)]</field>
        <field name="view_ids" eval="[(5,0,0),
                                            (0,0,{'view_mode':'list', 'view_id': ref('teacher_list_view')}),
                                            (0,0,{'view_mode':'form', 'view_id': ref('teacher_form_view')}),
                                            ]"/>
    </record>

    <!-- ############ VISTA DE LISTA PARA ESTUDIANTES ############### -->
    <record id="student_list_view" model="ir.ui.view">
        <field name="name">student.list.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml"> 
            <list string="Student">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/> 
                <field name="is_student"/> 
            </list>
        </field>
    </record>

    <record id="student_form_view" model="ir.ui.view">
        <field name="name">student.form.view</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/> 
                        <field name="is_student"/> 
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_student', '=', True)]</field>
        <field name="view_ids" eval="[(5,0,0),
                                            (0,0,{'view_mode':'list', 'view_id': ref('student_list_view')}),
                                            (0,0,{'view_mode':'form', 'view_id': ref('student_form_view')}),
                                            ]"/>
    </record>
</odoo>